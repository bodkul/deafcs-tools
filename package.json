    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
